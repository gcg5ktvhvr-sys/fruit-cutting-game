/**pages/game/game.wxss**/
page {
  background: #000;
  color: #fff;
  font-family: 'Arial', sans-serif;
}

.game-container {
  position: relative;
  overflow: hidden;
  background: #000;
}

.game-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  transition: all 200ms ease-out;
}

/* 游戏头部 */
.game-header {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0;
  background: rgba(0, 0, 0, 0.5);
  border-bottom: 2rpx solid #667eea;
  backdrop-filter: blur(10px);
}

.header-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.header-item .label {
  font-size: 24rpx;
  color: #999;
}

.header-item .value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

/* 血条系统 */
.blood-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: rgba(0, 0, 0, 0.3);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.blood-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  min-width: 80rpx;
}

.blood-bar {
  flex: 1;
  height: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 15rpx;
  overflow: hidden;
  border: 1rpx solid #666;
  position: relative;
}

.blood-fill {
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, #4ade80, #22c55e);
  transition: width 300ms ease-out;
  box-shadow: 0 0 10rpx rgba(74, 222, 128, 0.6);
}

.blood-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: bold;
  min-width: 60rpx;
  text-align: right;
}

/* 游戏竞技区 */
.game-arena {
  position: relative;
  flex: 1;
  overflow: hidden;
  margin: 20rpx 0;
  min-height: 400rpx;
}

.fruits-container {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.fruit-item {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #fff;
  transition: all 100ms linear;
  user-select: none;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.4), inset -5rpx -5rpx 10rpx rgba(0, 0, 0, 0.2);
}

.fruit-name {
  font-size: 22rpx;
}

/* 判定结果飘字 */
.judgement-text {
  position: absolute;
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 0 10rpx rgba(0, 0, 0, 0.8);
  pointer-events: none;
  animation: float-up 1s ease-out forwards;
}

@keyframes float-up {
  0% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  100% {
    transform: translateY(-100rpx) scale(0.5);
    opacity: 0;
  }
}

/* 触摸区域 */
.touch-zone {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 100;
}

/* 底部控制栏 */
.bottom-controls {
  display: flex;
  justify-content: space-around;
  gap: 20rpx;
  padding: 20rpx;
  background: rgba(0, 0, 0, 0.7);
  border-top: 1rpx solid #667eea;
  backdrop-filter: blur(10px);
}

.control-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 15rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  cursor: pointer;
  transition: all 200ms ease-out;
  border: 2rpx solid transparent;
}

.start-btn {
  background: linear-gradient(135deg, #4ade80, #22c55e);
  color: #fff;
}

.start-btn:active {
  transform: scale(0.95);
  box-shadow: 0 0 20rpx rgba(74, 222, 128, 0.6);
}

.pause-btn {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #000;
}

.pause-btn:active {
  transform: scale(0.95);
}

.restart-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.restart-btn:active {
  transform: scale(0.95);
  box-shadow: 0 0 20rpx rgba(102, 126, 234, 0.6);
}

.stats-btn {
  background: linear-gradient(135deg, #06b6d4, #0891b2);
  color: #fff;
}

.stats-btn:active {
  transform: scale(0.95);
}

/* 游戏结束弹窗 */
.game-over-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fade-in 300ms ease-out;
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  border: 2rpx solid #667eea;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.8);
  animation: scale-in 300ms ease-out;
}

@keyframes scale-in {
  from {
    transform: scale(0.8);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.modal-title {
  font-size: 44rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #ffd700;
}

.modal-stats {
  margin-bottom: 30rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 28rpx;
}

.stat-label {
  color: #999;
}

.stat-value {
  color: #fff;
  font-weight: bold;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  cursor: pointer;
  transition: all 200ms ease-out;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #4ade80, #22c55e);
  color: #fff;
}

.modal-btn.primary:active {
  transform: scale(0.95);
  box-shadow: 0 0 20rpx rgba(74, 222, 128, 0.6);
}

.modal-btn.secondary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.modal-btn.secondary:active {
  transform: scale(0.95);
  box-shadow: 0 0 20rpx rgba(102, 126, 234, 0.6);
}

/* 暂停遮罩 */
.pause-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
}

.pause-text {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 0 20rpx rgba(0, 0, 0, 0.8);
}
